#!/usr/bin/env python3
"""Validate docs/evidence.json (SPEC TS-11): a claim marked ok needs an https URL; every required claim must be listed.
Exit 0 when valid (pending rows are allowed and reported), 1 otherwise."""
import os, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
from vigil.docsgen import load_evidence, validate_evidence  # noqa: E402

path = sys.argv[1] if len(sys.argv) > 1 else "docs/evidence.json"
try:
    items = load_evidence(path)
except (OSError, ValueError) as e:
    print(f"EVIDENCE BROKEN: cannot read {path}: {e}")
    sys.exit(1)
errors = validate_evidence(items)
if errors:
    print("EVIDENCE BROKEN:")
    for e in errors:
        print("  " + e)
    sys.exit(1)
ok = sum(1 for i in items if i["status"] == "ok")
pending = [i["claim"] for i in items if i["status"] == "pending"]
print(f"EVIDENCE OK: {ok} ok, {len(pending)} pending (SIMULATED project)")
for c in pending:
    print("  PENDING: " + c)
