# Copy to .env and fill in. NEVER commit .env. Names only here.
NEATLOGS_API_KEY=            # PROJECT API key (not the nlw_ HTTP ingest key)
LLM_API_KEY=                   # the team LiteLLM key; LITELLM_API_KEY is read as a fallback name
LLM_BASE_URL=https://litellm.vision.aivar.app/v1
LLM_MODEL=claude-haiku
VIGIL_MAX_STEPS=8
DAILY_LIVE_BUDGET_TOKENS=200000
VIGIL_MODE=offline           # live | replay | offline
VIGIL_DB_PATH=data/vigil.db
PUBLIC_BASE_URL=
LLM_PRICE_IN_USD_MICRO_PER_MTOK=    # optional: micro-USD per million input tokens (from the provider price list); empty = cost not computed
LLM_PRICE_OUT_USD_MICRO_PER_MTOK=   # optional: micro-USD per million output tokens
VIGIL_RECEIPTS_DIR=receipts/web      # web app: where the served demo receipts are written (gitignored)
VIGIL_REPO_URL=https://github.com/MusaAis/vigil   # base for commit and file links on /proof
